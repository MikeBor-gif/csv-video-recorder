# Copy to .env and change the values (.env is ignored by git).
#   cp .env.example .env
# Without .env, docker-compose.yml uses the local defaults shown here.

DB_NAME=videos
DB_USER=video_user
DB_PASSWORD=video_pass

# DEBUG, INFO, WARNING, ERROR
WEB_SERVICE_LOG_LEVEL=INFO
# Maximum upload size in megabytes
MAX_UPLOAD_MB=512

# Zoom processing runs synchronously inside web (seconds).
FFMPEG_PATH=ffmpeg
ZOOM_PROCESS_TIMEOUT=300
# Must exceed ZOOM_PROCESS_TIMEOUT by at least 120 seconds.
ZOOM_HTTP_TIMEOUT=600
ZOOM_LOG_LEVEL=INFO

# Task 3: only required when running enrich_companies.py, never for web startup.
# Put the actual instructor key only in your local .env (excluded from Git/image).
DEEPSEEK_API_KEY=
# Code default per Task 3; choose an available model explicitly if needed.
DEEPSEEK_MODEL=deepseek-chat
ENRICH_LOG_LEVEL=DEBUG
