# Copy to .env and change the values (.env is ignored by git).
#   cp .env.example .env
# Without .env, docker-compose.yml uses the local defaults shown here.

DB_NAME=videos
DB_USER=video_user
DB_PASSWORD=video_pass

# DEBUG, INFO, WARNING, ERROR
WEB_SERVICE_LOG_LEVEL=INFO
# Maximum upload size in megabytes
MAX_UPLOAD_MB=512
